# Copy to .env and fill in. Never commit .env. All variables are read by config.py (pydantic-settings).

# --- LLM provider ---
# Which provider app/llm.py calls: gemini | openai | groq
LLM_PROVIDER=gemini
# Optional model override; empty = provider default from config.LLM_MODELS
LLM_MODEL=
# API key for the selected provider (only the one matching LLM_PROVIDER is required)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- API ---
# Required. Comma-separated <key>:<role> pairs; role is customer | employee | admin.
# The role of every request comes from its X-API-Key header. Use long random keys,
# e.g. generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Comma-separated origins allowed by CORS (the Streamlit UI by default)
CORS_ORIGINS=http://localhost:8501
# Log level for the JSON logs: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- UI ---
# Where the Streamlit UI finds the API
API_URL=http://localhost:8000
